HOST=127.0.0.1
PORT=8000

# Hugging Face download settings for Windows stability.
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30

# ASR. small is a good CPU baseline; large-v3-turbo is better with NVIDIA GPU.
WHISPER_MODEL=small
ASR_DEVICE=auto
ASR_COMPUTE_TYPE=

# Local RU -> EN translation model.
MT_MODEL=Helsinki-NLP/opus-mt-ru-en
MT_DEVICE=cpu

# Voice clone settings.
TTS_DEVICE=auto
CHATTERBOX_T3=v3
VOICE_REFERENCE_SECONDS=5

# Phrase segmentation.
VAD_RMS=420
MIN_SEGMENT_SECONDS=0.7
MAX_SEGMENT_SECONDS=7
SILENCE_MS=420
